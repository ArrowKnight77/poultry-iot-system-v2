# Absolute path to this repository on the server.
PROJECT_DIR=/home/admnyc/py/poultry-iot-system-v2

# Local server copy created by scripts/backup_postgres.sh.
BACKUP_LOCAL_DIR=/srv/poultry-backups

# Existing rclone crypt remote backed by the shared Google Drive folder.
# Configure OAuth and encryption credentials separately with rclone.
BACKUP_RCLONE_CRYPT_REMOTE=poultry-offsite-crypt:

# Prevent concurrent manual and scheduled 3-2-1 executions.
BACKUP_LOCK_FILE=/srv/poultry-backups/.backup-3-2-1.lock
