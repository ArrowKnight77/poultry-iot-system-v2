# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example

# Private keys, certificates, and tunnel credentials
*.pem
*.key
*.crt
*.p12
*.pfx
.cloudflared/
mosquitto/config/passwd

# Logs, dumps, and backups
*.log
debug/
backups/
*.sql
*.sql.gz
*.partial
rclone.conf
backup.env

# Las migraciones SQL forman parte del código versionado.
!scripts/migrations/*.sql
*.dump
*.bak

# Notebooks and generated data
*.ipynb_checkpoints/
ML/*.csv
ML/*.xlsx
ML/*.json

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
.~lock.*#

# Local document-generation workspaces
.codex-doc-*/
.tmp_*_caps/

# Local testing files — track scripts but not data files
local_tests/*
!local_tests/.gitkeep
!local_tests/*.py
!local_tests/fixtures/
!local_tests/fixtures/nginx/
!local_tests/fixtures/nginx/*.conf

# Claude Code session data
.claude/
.postman/

# Local MQTT credentials
mosquitto/config/passwd

# Local MQTT TLS material
mosquitto/certs/
.venv-simulator/
