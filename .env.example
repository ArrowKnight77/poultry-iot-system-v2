# Local Docker configuration
POSTGRES_USER=avicola_local_user
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_DB=avicola_local_db

# Flask
FLASK_ENV=production
SECRET_KEY=generar_con_python_secrets_token_hex_32
CORS_ORIGINS=http://localhost:5001
DASHBOARD_CORS_ORIGINS=http://localhost:5000,http://localhost:5001
INGEST_API_KEY=generar-una-contraseña-segura
SECURITY_EVENTS_API_KEY=generar_con_python_secrets_token_urlsafe_48
JWT_SECRET_KEY=generar_con_python_secrets_token_hex_32
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
# MQTT local-only defaults
MQTT_BROKER=mqtt
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_TOPIC=sensor/+/+
MQTT_USERNAME=mqtt_sensor_user
MQTT_PASSWORD=generar_password_seguro
MQTT_SUBSCRIBER_USERNAME=mqtt_subscriber_user
MQTT_SUBSCRIBER_PASSWORD=generar_password_seguro
# Internal service URLs used by Docker Compose
API_BASE_URL=http://api:5000
API_URL=http://api:5000/lecturas

# Telegram notifications (optional — leave empty to disable)
# 1. Talk to @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your bot, send /start
# 3. Get your chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bloqueo temporal persistente ante fallos consecutivos de login
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Llave interna para que el dashboard autenticado delegue acciones protegidas a la API.
DASHBOARD_PROXY_KEY=generar_con_python_secrets_token_urlsafe_48
