# Local Docker configuration
POSTGRES_USER=avicola_local_user
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_DB=avicola_local_db

# Flask
FLASK_ENV=development
SECRET_KEY=generar_con_python_secrets_token_hex_32
CORS_ORIGINS=http://localhost:5001
DASHBOARD_CORS_ORIGINS=http://localhost:5000,http://localhost:5001
INGEST_API_KEY=7fa239e529ad5d7146dac4cb30b891d95e846c6b3b365d78c1b96b865ce993be
# MQTT local-only defaults
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC=sensor/+/data

# Internal service URLs used by Docker Compose
API_BASE_URL=http://api:5000
API_URL=http://api:5000/lecturas

# Telegram notifications (optional — leave empty to disable)
# 1. Talk to @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your bot, send /start
# 3. Get your chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
